{% for vhost in reverse_http %}
{% if vhost.ssl_force_redirect %}
server {
    listen 80;
    server_name {{ vhost.server_name }};
    return 301 https://$host$request_uri;
}
{% endif %}

server {

    listen {{ vhost.listen_port }}{% if vhost.ssl %} ssl{% endif %};
    server_name {{ vhost.server_name }};

    {% if vhost.ssl -%}
    ssl_certificate {{ vhost.ssl_certificate }};
    ssl_certificate_key {{ vhost.ssl_certificate_key }};
    {% endif %}

    {% for location in vhost.locations -%}
    location {{ location.path }} {
    
      {% set backend = (vhost.backends
          | selectattr('name', 'equalto', location.backend)
          | first) -%}
      proxy_pass {{ backend.protocol }}://{{ backend.name }};
      proxy_set_header Host {{ vhost.server_name }};
      
      # WebSocket + SSE
      proxy_http_version 1.1;
      
      {% if location.upgrade -%}
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      {% endif -%}
      
      # Keep client IP
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      # Timeouts
      proxy_read_timeout {{ location.read_timeout }};
      proxy_send_timeout {{ location.send_timeout }};
      
      {% if location.allow_hosts and location.auth_basic -%}
      # Satisfy any/all conditions
      satisfy {{ location.satisfy_policy }};
            
      {% endif -%}
      {% if location.allow_hosts -%}
      # Allow hosts
      {% for ip in location.allow_hosts -%}
      allow {{ ip }};
      {% endfor -%}
      deny all;
            
      {% endif -%}
      {% if location.auth_basic -%}
      # Basic Auth
      auth_basic "{{ location.auth_basic_prompt }}";
      auth_basic_user_file {{ location.auth_basic_user_file }};
      
      {% endif -%}
      
      # Client max body size
      client_max_body_size {{ location.client_max_body_size }};
              
    }

{% endfor %}
}

{% for backend in vhost.backends %}
upstream {{ backend.name }} {
    server {{ backend.address }};
}
{% endfor %}
{% endfor %}
